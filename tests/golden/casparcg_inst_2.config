<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <log-level>info</log-level>

  <channels>
    <!-- Instance 2 -->
    <channel>
      <video-mode>1080p5000</video-mode>
      <consumers>
        <ndi>
          <name>PCR3 MEDIA1</name>
          <allow-fields>false</allow-fields>
        </ndi>
      </consumers>
    </channel>
  </channels>

  <paths>
    <media-path>media\</media-path>
    <log-path>log\inst_2\</log-path>
    <data-path>data\inst_2\</data-path>
    <template-path>template\</template-path>
  </paths>

  <controllers>
    <tcp>
      <port>5251</port>
      <protocol>AMCP</protocol>
    </tcp>
  </controllers>

  <html>
    <remote-debugging-port>0</remote-debugging-port>
    <enable-gpu>false</enable-gpu>
    <cache-path>html_cache\inst_2\</cache-path>
  </html>

</configuration>
